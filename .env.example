# Ollama server URL (defaults to localhost)
OLLAMA_HOST=http://127.0.0.1:11434

# Default model. Anything Ollama can run. Recommend a 7B+ instruct model.
# Examples: llama3.1:8b, llama3.1:70b, qwen2.5:14b, mistral-nemo:12b
NOX_MODEL=llama3.1:8b

# Where the SQLite database lives. Defaults to ./data/nox.db
# NOX_DATA_DIR=./data
